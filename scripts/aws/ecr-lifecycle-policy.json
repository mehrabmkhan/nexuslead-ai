{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Expire untagged images after one day",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Keep the latest five versioned deployment images",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": [
          "20"
        ],
        "countType": "imageCountMoreThan",
        "countNumber": 5
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
